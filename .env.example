NODE_ENV=development
LOG_LEVEL=info

# --- Postgres / Redis (docker compose up -d) ---
DATABASE_URL=postgresql://clipforge:clipforge@localhost:5432/clipforge?schema=public
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally; Cloudflare R2 / S3 in production) ---
S3_ENDPOINT=http://localhost:9000
# Only if the BROWSER reaches storage at a different address than the API does:
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clipforge
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Production: set to your parent domain (e.g. .example.com) so app.example.com can see the API's session cookie
# COOKIE_DOMAIN=.example.com
SESSION_DAYS=30
# Number of reverse proxies in front of the API (1 behind Caddy/nginx/Cloudflare/ALB)
TRUST_PROXY=0
MAX_UPLOAD_MB=2048
MAX_VIDEO_MINUTES=120
MAX_ACTIVE_PROJECTS=3
RATE_LIMIT_GLOBAL=600
RERENDER_LIMIT_PER_HOUR=30
# Free credits for new accounts. 30 is handy locally; use 0 in production if you don't offer a free trial.
SIGNUP_BONUS_CREDITS=30

# --- Payments (Razorpay). Leave empty to disable checkout. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Data retention ---
SOURCE_RETENTION_DAYS=7
CLIP_RETENTION_DAYS=30

# --- Worker ---
WORKER_CONCURRENCY=1
RERENDER_CONCURRENCY=1
# Any OpenAI-compatible Whisper endpoint. Default is Groq.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3-turbo
ANTHROPIC_API_KEY=
CLIP_MODEL=claude-sonnet-5-5
PYTHON_BIN=python3
# Optional, helps when YouTube blocks datacenter IPs
# YTDLP_COOKIES_FILE=/secrets/cookies.txt
# YTDLP_PROXY=http://user:pass@host:port

# --- Observability ---
# Prometheus scrape token (API /metrics and worker :9100/metrics). In production /metrics is off unless this is set.
# METRICS_TOKEN=change-me
METRICS_PORT=9100
# SENTRY_DSN=
